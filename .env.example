VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Supabase Edge Function secrets for email notifications (server-side only,
# set in the Supabase dashboard — never referenced from the frontend)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=MAYA Tracker <notifications@your-domain.com>

# Kept temporarily so the old Next.js app still runs side-by-side during the
# migration. Removed once Next.js is removed.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
