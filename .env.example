VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Existing Vercel projects migrated from Next.js may keep the equivalent
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY names.

# Supabase Edge Function secrets for email notifications (server-side only,
# set in the Supabase dashboard — never referenced from the frontend)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=MAYA Tracker <notifications@your-domain.com>
