VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Existing Vercel projects migrated from Next.js may keep the equivalent
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY names.

# Supabase Edge Function secrets for Gmail SMTP notifications (server-side
# only; set in the Supabase dashboard and never expose them to the frontend).
# SMTP_PASSWORD must be a Google App Password, not the Gmail account password.
# Resend for password-recovery emails is configured separately under
# Supabase Authentication > Emails > SMTP Settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tasksmaya@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=MAYA Tracker <tasksmaya@gmail.com>

# Supabase Edge Function secret used only by pg_cron. Generate a long random
# value and store the identical value in Supabase Vault as maya_cron_secret.
CRON_SECRET=replace-with-at-least-32-random-bytes
